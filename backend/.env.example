# App runtime connection -- non-superuser role (created by migration 0003).
# PostgreSQL superusers/table owners bypass Row-Level Security entirely, so
# the app must NOT connect as the docker-compose superuser (steel_recon).
DATABASE_URL=postgresql+asyncpg://steel_recon_app:dev_app_password@localhost:5432/steel_recon

# Alembic connection -- needs owner/superuser privileges for DDL, CREATE ROLE, GRANT.
MIGRATION_DATABASE_URL=postgresql+asyncpg://steel_recon:dev_password@localhost:5432/steel_recon

JWT_SECRET_KEY=change-me-in-production-use-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
